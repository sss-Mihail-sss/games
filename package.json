{
  "name": "games.secrii.dev",
  "type": "module",
  "private": true,
  "packageManager": "bun@1.4.5",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*",
      "games/*"
    ],
    "catalog": {
      "typescript": "7.1.0-beta",
      "zod": "4.6.0",
      "react": "19.3.0",
      "react-dom": "19.3.0",
      "@types/react": "19.3.0",
      "@types/react-dom": "19.3.0",
      "@types/node": "26.6.6",
      "next": "16.4.5",
      "three": "0.187.0",
      "@types/three": "0.187.0",
      "tailwindcss": "4.3.5",
      "@tailwindcss/turbopack": "4.3.5",
      "@types/bun": "1.4.4",
      "@dimforge/rapier3d-deterministic-compat": "0.21.0",
      "@gltf-transform/core": "4.5.1",
      "@gltf-transform/extensions": "4.5.1",
      "@gltf-transform/functions": "4.5.1",
      "meshoptimizer": "1.3.0"
    }
  },
  "scripts": {
    "lint": "bun lint",
    "fmt": "bun fmt",
    "dev": "bun run --parallel --filter '*' dev",
    "dev:web": "bun run --filter web dev",
    "dev:api": "bun run --filter api dev",
    "dev:game": "bun run --filter game-server dev",
    "typecheck": "bun run --filter web typegen && bun check",
    "test": "bun test --pass-with-no-tests",
    "assets": "bun scripts/optimize-assets.ts"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@gltf-transform/core": "catalog:",
    "@gltf-transform/extensions": "catalog:",
    "@gltf-transform/functions": "catalog:",
    "meshoptimizer": "catalog:"
  },
  "peerDependencies": {
    "typescript": "catalog:"
  }
}
