{
  "name": "games.secrii.dev",
  "type": "module",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*",
      "games/*"
    ],
    "catalog": {
      "typescript": "7.1.0-beta",
      "zod": "4.6.0",
      "react": "19.3.0",
      "react-dom": "19.3.0",
      "@types/react": "19.3.0",
      "@types/react-dom": "19.3.0",
      "@types/node": "24.19.2",
      "next": "16.4.5"
    }
  },
  "scripts": {
    "lint": "bun lint",
    "fmt": "bun fmt",
    "dev": "bun run --parallel --filter '*' dev",
    "dev:web": "bun run --filter web dev",
    "dev:api": "bun run --filter api dev",
    "dev:game": "bun run --filter game-server dev",
    "typecheck": "bun check",
    "test": "bun test --pass-with-no-tests"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "catalog:"
  }
}
