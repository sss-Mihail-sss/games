{
  "extends": "../../tsconfig.base.json",
  // next-env.d.ts and .next/types are generated by `next typegen` (see the root
  // `typecheck` script). They carry route types and the `next/root-params` getters.
  "include": ["next-env.d.ts", ".next/types/**/*.ts", "src"],
  "compilerOptions": {
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx"
  }
}
